############################################
# Core environment identity
############################################

# Project name used as the shared naming and tagging baseline across this
# environment.
project_name = "aws-serverless-events-platform"

# Deployment environment name for this root module.
environment = "dev"

############################################
# AWS configuration
############################################

# AWS region where this environment will be deployed.
aws_region = "eu-central-1"

############################################
# Environment behavior overrides
############################################

# Keep PITR disabled in dev to reduce always-on test-environment cost.
dynamodb_point_in_time_recovery_enabled = false

# Keep WAF disabled in dev until the frontend is actively used to avoid steady
# Web ACL and rule charges in this portfolio environment.
enable_waf = false

############################################
# Admin notification subscriptions
############################################

# Optional admin/developer email endpoints for SNS admin notifications.
# Keep this empty in committed examples. Put real email addresses only in local
# untracked terraform.tfvars.
sns_admin_email_subscriptions = []

############################################
# Participant email sender identity
############################################

# Keep this as a placeholder in committed examples. Put the real dedicated
# project inbox sender email only in local untracked terraform.tfvars.
#
# The configured inbox receives an SES verification email after the SES module
# is applied. The inbox owner must confirm that verification before SES can
# send participant notification emails from this address.
ses_sender_email = "participant-notifications@example.com"
